generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT // นิสิต
  DEPARTMENT_HEAD // หัวหน้าภาควิชา
  FACULTY_STAFF // เจ้าหน้าที่คณะ
  DEPUTY_DEAN // รองคณบดี
  DEAN // คณบดี
  SA_STAFF // เจ้าหน้าที่กองกิจการนิสิต
  COMMITTEE // คณะกรรมการ
  CHAIRMAN // ประธาน
  FINANCIAL // เจ้าหน้าที่การเงิน
  NOT_ASSIGNED // ไม่ได้กำหนดสิทธิ์
}

enum RequestStatus {

  PENDING_DEPUTY_DEAN
  PENDING_DEAN
  PENDING_SA
  PENDING_BOARD
  PENDING_CHAIRMAN
  APPROVED
  REJECTED
}

enum CheckReject {
  NOT_REJECTED
  REJECTED_DEPUTY_DEAN
  REJECTED_DEAN
  REJECTED_SA
  REJECTED_BOARD
  REJECTED
}

enum SchType {
  INNOVATION
  WELL_BEHAVIOR
  EXTRACURRICULAR
  OTHER
}

enum ExtracurricularType {
  // การแข่งขันอะไรก็ได้ที่ไม่ใช่ innovation
  UNIVERSITY_COMPETITION // การแข่งขันระดับมหาวิทยาลัย
  NATIONAL_COMPETITION // การแข่งขันระดับประเทศ
  INTERNATIONAL_COMPETITION // การแข่งขันระดับนานาชาติ

  POSITION // ตำแหน่ง
  SOCIAL // กิจกรรมสังคม
}

enum InnovationType {
  UNIVERSITY_COMPETITION
  NATIONAL_COMPETITION
  INTERNATIONAL_COMPETITION
}

enum ActivityHour {
  SPORT
  ENVIRONMENT
  CULTURE
  VIRTUE
  OTHER
}

enum CompetitiveLevel {
  TERTIARY
  NATIONAL
  INTERNATIONAL
}

enum ProgramType {
  THAI
  INTERNATIONAL
  BOTHTHAIANDINTERNATIONAL
}

enum reward {
  UNIVERSITYPRICE
  FACULTYPRICE
  CREDITPRICE
}

enum QuestionType {
  TEXT
  CHOICE
  CHECKBOX
  DATE
}

model User {
  id                String  @id @default(cuid()) @map("_id") // รหัสนิสิต หรือ รหัสเจ้าหน้าที่
  prenameTh         String? // คำนำหน้าชื่อ
  firstnameTh       String // ชื่อจริง ภาษาไทย
  lastnameTh        String // นามสกุล ภาษาไทย
  prenameEn         String?
  firstnameEn       String // ชื่อจริง ภาษาอังกฤษ
  lastnameEn        String // นามสกุล ภาษาอังกฤษ
  role              Role
  major             String? // คณะ (เฉพาะนิสิต)
  faculty           String? // สังกัด, คณะ
  isAcceptPolicy     Boolean? // ยอมรับนโยบายการใช้งาน
  // birthdate DateTime?
  advisor String? // อาจารย์ที่ปรึกษา (เฉพาะนิสิต)
  gpa     Float? // เกรดเฉลี่ย (เฉพาะนิสิต)

  // เฉพาะเจ้าหน้าที่
  position     String?
  positionId   String?
  department   String?
  departmentId String?

  // ข้อมูลการติดต่อ
  email       String   @unique
  // emailVerified DateTime?
  mobilePhone String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  // Form        Form[] @relation("UserForm")
  // CommentUser Form[] @relation("CommentedUserForm")
}

model Form {
  id            String @id @map("_id")
  createdBy      String
   scholarshipID      String
  scholarship   Scholarship  @relation(fields: [scholarshipID], references: [id],onDelete: Cascade, onUpdate: Cascade)
  schType       SchType
  approveStatus RequestStatus
  checkReject CheckReject

  nisitNameTh       String
  nisitNameEn       String
  nisitAcademicyear String
  nisitid           String
  faculty           String
  department        String
  advisor           String
  gpa               Float
  dateofBirth       DateTime
  age               String
  phone             String
  email             String
  address           String
  isLastTerm        Boolean

  programType  ProgramType
  study        String?

  academicYear String
  term         String

  universityPrice  Float?
  facultyPrice     Float?
  creditPrice      Float?
  sumPrice         Float?

  newUniversityPrice  Float?
  newFacultyPrice     Float?
  newCreditPrice      Float?
  newSumPrice         Float?
  // Depend on scholarship type (innovation, extracurricular)
  certificate       String?
  activityImageUrl  String?

  staticQuestions  Question[]
  dynamicQuestions DynamicQuestionResponse[]

  innovation      InnovationQuestion?
  wellBehavior    WellBehaviorQuestion?
  extracurricular ExtracurricularQuestion?

  comment     String?
  commentedBy String?
  

  // Relationships
  // commentedUser   User? @relation("CommentedUserForm", fields: [commentedBy], references: [id])
  // user            User        @relation("UserForm", fields: [createdBy], references: [id])
  // certificateFile File? @relation("FileForm", fields: [certificate], references: [id])
}

type DynamicQuestionResponse {
  question     String
  type         QuestionType
  options      String[]
  required     Boolean
  answer       String?
  selectedDate DateTime?
}

type DynamicQuestionTemplate {
  question String
  type     QuestionType
  options  String[]
  required Boolean
}

model Scholarship {
  id               String   @id @default(cuid()) @map("_id")
  schName          String
  description      String
  academiYear      String
  term             String
  // amount      Float
  startDate        DateTime
  endDate          DateTime
  schType          SchType
  // attachment  String?
  // price       String
  // reward      reward
  // otherReward String?
  programType      ProgramType
  dynamicQuestions DynamicQuestionTemplate[]
  pdfUrl           String
  // file      File?      @relation("ScholarshipFile", fields: [attachment], references: [id])
  // termprice Termprice? @relation("TermpriceScholarship", fields: [termpriceid], references: [id], onDelete: Cascade)
  // termpriceid String?

  Form Form[]
}

model assignrole {
  id        String @id @default(cuid()) @map("_id")
  usergmail String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model File {
  id String @id @default(cuid()) @map("_id")

  filename String
  mimetype String
  data     String

  // Relationships
  // form Form[] @relation("FileForm")
  // scholarship Scholarship[] @relation("ScholarshipFile")
}

model Termprice {
  id           String @id @default(cuid()) @map("_id")
  faculty      String
  department   String?
  academicYear String
  term         String
  programType  String // ไทย,นานาชาติ
  study        String? // ปกติ,พิเศษ
  price1       Float
  price2       Float
  price3       Float
  sumPrice     Float // ค่าเทอมแบ่งเป็นส่วนย่อย 3 ส่วน

  // Relationships
  // scholarship Scholarship[] @relation("TermpriceScholarship")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

type Question {
  question String
  answer   String?
}

type InnovationQuestion {

  awardDate        DateTime
  competitionName  String
  teamName         String
  innovationName   String
  prizeName        String
  organizer        String
  competitiveLevel CompetitiveLevel
  numberOfTeam     Int
  activityHour     ActivityHour
  attachfile       String
}

type WellBehaviorQuestion {
  beahavior_detail String
}

type ExtracurricularQuestion {
  extracurricularType ExtracurricularType

  awardDate        DateTime?
  competitionName  String?
  teamName         String?
  innovationName   String?
  prizeName        String?
  organizer        String?
  competitiveLevel CompetitiveLevel?
  numberOfTeam     Int?
  activityHour     ActivityHour?
  attachfile       String?
}
